{
  "name": "heimdallr-sdk",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "author": "LucivHuang",
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node ./scripts/run.js",
    "build": "cross-env NODE_ENV=production node ./scripts/run.js",
    "build:packages": "pnpm -r --if-present --filter \"./libs/*\" --filter \"./clients/*\" --filter \"./browser_plugins/*\" --filter \"./wx_plugins/*\" --filter \"./tools/*\" run build",
    "gc": "node ./scripts/commit.js",
    "prisma": "pnpm --filter @heimdallr-sdk/server prisma",
    "prepare": "husky install",
    "lint": "eslint \"{libs,clients,browser_plugins,wx_plugins,tools}/**/src/**/*.ts\"",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --config commitlint.config.js -e -V",
    "cs": "changeset",
    "uc": "changeset version",
    "release": "changeset publish --access=public",
    "test": "pnpm test:setup && playwright test --config=e2e/config/playwright.config.ts",
    "test:setup": "npx prisma generate --schema=./playground/server/schema.prisma && pnpm exec playwright install chromium",
    "test:e2e:ui": "playwright test --config=e2e/config/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=e2e/config/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config=e2e/config/playwright.config.ts --headed",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucivHuang/heimdallr-sdk.git"
  },
  "keywords": [
    "heimdallr-sdk",
    "error",
    "performance",
    "monitor",
    "sourcemap",
    "collect",
    "browser",
    "node",
    "wechat",
    "miniprogram",
    "vue"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.8",
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^4.8.1",
    "@rollup/plugin-commonjs": "^22.0.1",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@typescript-eslint/eslint-plugin": "^5.30.7",
    "@typescript-eslint/parser": "^5.30.7",
    "body-parser": "^1.20.0",
    "boxen": "^5.1.2",
    "browser-sync": "^2.27.10",
    "chalk": "^4.1.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.14.49",
    "eslint": "^8.20.0",
    "eslint-plugin-html": "^7.0.0",
    "husky": "^8.0.1",
    "inquirer": "^8.1.5",
    "lint-staged": "^13.0.3",
    "miniprogram-api-typings": "^4.0.5",
    "multer": "^1.4.5-lts.1",
    "npm-run-all": "^4.1.5",
    "prisma": "^4.8.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.76.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^4.9.1",
    "rollup-plugin-polyfill-node": "^0.10.2",
    "rollup-plugin-sizes": "^1.0.4",
    "source-map": "^0.7.4",
    "ts-node": "^10.8.2",
    "tslib": "^2.4.0",
    "typescript": "^4.9.5"
  }
}
